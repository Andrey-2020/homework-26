@startuml er-data-model
title Booking.com — модель данных
left to right direction
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
allowmixing

package "Catalog Service — PostgreSQL (SoT)" {
  entity "asset" as asset {
    * id : uuid <<PK>>
    --
    * partner_id : uuid
    * name : text
    stars : smallint
    * lat : numeric
    * lon : numeric
    amenities : jsonb
    thumbnail_url : text
    status : text
    updated_at : timestamptz
  }
  entity "room_types" as room_types {
    * id : uuid <<PK>>
    --
    * asset_id : uuid <<FK>>
    * name : text
    capacity : int
  }
  entity "tariff_plans" as tariff_plans {
    * id : uuid <<PK>>
    --
    * room_type_id : uuid <<FK>>
    * currency : char(3)
    * base_price : numeric
    cancellation_policy : jsonb
  }
  entity "outbox_catalog" as outbox_catalog {
    * id : bigserial <<PK>>
    --
    aggregate_id : uuid
    event_type : text
    payload : jsonb
    published_at : timestamptz
  }
  asset ||--o{ room_types
  room_types ||--o{ tariff_plans
}

package "Inventory Service — PostgreSQL (SoT)" {
  entity "room_counts_by_date" as room_counts_by_date {
    * asset_id : uuid <<PK>>
    * room_type_id : uuid <<PK>>
    * business_date : date <<PK>>
    --
    * allotment_total : int
    * allotment_sold : int
  }
  entity "holds" as holds {
    * hold_id : uuid <<PK>>
    --
    * booking_id : uuid <<logical_ref>>
    * asset_id : uuid
    * room_type_id : uuid
    * date_from : date
    * date_to : date
    quantity : int
    * status : text
    * expires_at : timestamptz
  }
  entity "outbox_inventory" as outbox_inventory {
    * id : bigserial <<PK>>
    --
    aggregate_id : uuid
    event_type : text
    payload : jsonb
    published_at : timestamptz
  }
  note bottom of room_counts_by_date
    Шардируется по asset_id
  end note
}

package "Booking Service — PostgreSQL (SoT)" {
  entity "bookings" as bookings {
    * booking_id : varchar <<PK>>
    --
    * guest_id : uuid
    * asset_id : uuid <<logical_ref>>
    * room_type_id : uuid <<logical_ref>>
    * check_in : date
    * check_out : date
    * status : text
    price_snapshot : jsonb
    hold_id : uuid <<logical_ref>>
    payment_intent_id : uuid <<logical_ref>>
    saga_step : text
    updated_at : timestamptz
  }
  entity "idempotency_requests" as idem_booking {
    * key : text <<PK>>
    --
    * guest_id : uuid
    request_hash : text
    response_snapshot : jsonb
  }
  entity "outbox_booking" as outbox_booking {
    * id : bigserial <<PK>>
    --
    aggregate_id : varchar
    event_type : text
    payload : jsonb
    published_at : timestamptz
  }
}

package "Payment Service — PostgreSQL (SoT)" {
  entity "payment_intents" as payment_intents {
    * id : uuid <<PK>>
    --
    * booking_id : varchar <<logical_ref>>
    * amount : numeric
    * currency : char(3)
    * status : text
    provider_ref : text
    updated_at : timestamptz
  }
  entity "refunds" as refunds {
    * refund_id : uuid <<PK>>
    --
    * payment_intent_id : uuid <<FK>>
    * amount : numeric
    * status : text
    provider_ref : text
    idempotency_key : text <<UQ>>
  }
  entity "idempotency_keys" as idem_payment {
    * key : text <<PK>>
    --
    * operation : text
    request_hash : text
    response_snapshot : jsonb
  }
  entity "payment_log" as payment_log {
    * provider_event_id : text <<PK>>
    --
    event_type : text
    payload : jsonb
    processed_at : timestamptz
  }
  entity "outbox_payment" as outbox_payment {
    * id : bigserial <<PK>>
    --
    aggregate_id : uuid
    event_type : text
    payload : jsonb
    published_at : timestamptz
  }
  payment_intents ||--o{ refunds
}

package "Search Service — OpenSearch (read model, not SoT)" {
  entity "asset_search_document" as asset_search_document {
    * assetId : keyword <<PK>>
    --
    name : text
    stars : integer
    geo : geo_point
    amenities : keyword[]
    roomTypes : nested
    minPrice : object
    availabilityHints : object[]
    sourceVersion : long
  }
  note bottom of asset_search_document
   Перестраивается на основе catalog.events и inventory.events.
   Допускается eventual consistency.
   Результаты поиска никогда не служат разрешением на продажу.
  end note
}

package "Ephemeral storage — Redis" {
  entity "cache / tariff-limit keys" as rediskeys {
    * key : string <<PK>>
    --
    value : bytes / counter
    expires_at : timestamp
  }
}

cloud "External Identity Provider\n(JWT/JWKS)" as IdP
rectangle "API Gateway\n(no business DB)" as Gateway
rectangle "Notification Service\n(stateless consumer; optional delivery log)" as Notification

Gateway ..> IdP : validate JWT / JWKS
Gateway ..> rediskeys : rate limit / key cache

@enduml