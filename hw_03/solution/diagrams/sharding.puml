@startuml
title Шардирование
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

package "Booking — шардирование по guest_id" {
  actor "Guest via Gateway\nPOST /bookings\nGET my bookings" as Guest
  queue "Kafka events\npayment / inventory" as Kafka

  rectangle "Booking Service" as BookingSvc {
    component "Shard Router\nconsistent hash(guest_id)\n16 virtual buckets" as RouterSvc
    component "Lookup by booking_id\nread embedded shard_id\nor consult directory" as Lookup
  }

  database "PostgreSQL shard 0" as Shard0
  database "PostgreSQL shard 1" as Shard1
  database "PostgreSQL shard 2" as Shard2
  database "PostgreSQL shard 3" as Shard3

  Guest --> RouterSvc : guest_id from JWT
  RouterSvc --> Shard0
  RouterSvc --> Shard1
  RouterSvc --> Shard2
  RouterSvc --> Shard3
  Kafka --> Lookup : booking_id in event
  Lookup --> Shard0
  Lookup --> Shard1
  Lookup --> Shard2
  Lookup --> Shard3

}
note bottom of RouterSvc
  guest_id обеспечивает размещение броней одного гостя на одном шарде.
  Первоначальное предложение: 4 физических шарда, 16 виртуальных бакетов.
end note

note top of Shard3
  booking_id содержит shard_id или разрешается через booking_id → shard_id.
  Это позволяет маршрутизировать события Saga без сканирования всех шардов.
end note

note bottom of Lookup
  Запрос по asset_id может потребовать scatter-gather или отдельной read-модели.
  B2B аккаунт с высоким спросом может стать hotspot.
end note

package "Inventory — шардирование по asset_id" {
  actor "Booking Service\nHold / Confirm / Release" as Booking
  actor "Partner API\nобновление room_counts_by_date" as Partner

  rectangle "Inventory Service" as Inventory {
    component "Shard Router\nconsistent hash(asset_id)\n16 virtual buckets" as Router
    component "Hold transaction\nlock slots for all nights\ncheck availability + write hold" as HoldTx
  }

  database "PostgreSQL shard 0" as S0
  database "PostgreSQL shard 1" as S1
  database "PostgreSQL shard 2" as S2
  database "PostgreSQL shard 3" as S3

  Booking --> Router : gRPC command
  Partner --> Router : room_counts_by_date update
  Router --> HoldTx : route by asset_id
  HoldTx --> S0 : asset → shard 0
  HoldTx --> S1 : asset → shard 1
  HoldTx --> S2 : asset → shard 2
  HoldTx --> S3 : asset → shard 3
}
note bottom of Router
  asset_id выбран потому, что
  выбранный тип номера и каждая ночь проживания остаются на одном шарде. 
  Первоначальное предложение: 4 физических шарда с 16 виртуальными бакетами.
end note

note bottom of HoldTx
  Риск горячего объекта:
  изолировать объект на выделенном шарде или выделить больше ресурсов.
end note
@enduml