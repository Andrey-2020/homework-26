@startuml
title Booking.com — cache-aside, invalidation and hold TTL
skinparam sequenceMessageAlign center
skinparam shadowing false

actor Guest
participant "API Gateway" as GW
participant "Search Service" as Search
participant "Catalog Service" as Catalog
participant "Booking Service" as Booking
database "Redis" as Redis
participant "OpenSearch" as OS
queue "Kafka" as Kafka
database "Catalog PostgreSQL" as CatDB
database "Booking PostgreSQL" as BookDB
database "Inventory PostgreSQL" as InvDB
participant "Inventory sweeper" as Sweeper

== Search results: cache-aside ==
Guest -> GW : GraphQL search
GW -> Search : Search(query)
Search -> Redis : GET search:{query_hash}
alt cache hit
  Redis --> Search : cached result (TTL 60s)
else cache miss
  Redis --> Search : miss
  Search -> OS : geo + filters + sort
  OS --> Search : search projection
  Search -> Redis : SET search:{query_hash} <result> EX 60
end
Search --> GW : results (availability is only a hint)

== Catalog card: event invalidation ==
Guest -> GW : GET asset card
GW -> Catalog : GetAsset(id)
Catalog -> Redis : GET catalog:asset:{id}
alt miss
  Catalog -> CatDB : SELECT asset / room types / tariffs
  CatDB --> Catalog : current data
  Catalog -> Redis : SET catalog:asset:{id} <current data> EX 600
end
Catalog --> GW : asset card
Catalog -> CatDB : UPDATE + insert outbox (transaction)
Catalog -> Kafka : catalog.updated
Catalog -> Redis : DEL catalog:asset:{id}
Kafka -> Search : project catalog.updated into OpenSearch

== Booking status: short-lived polling cache ==
Guest -> GW : GET /v1/bookings/{id}
GW -> Booking : GetStatus(id)
Booking -> Redis : GET booking:status:{id}
alt miss
  Booking -> BookDB : SELECT status
  BookDB --> Booking : status
  Booking -> Redis : SET booking:status:{id} <status> EX 2
end
Booking --> GW : status
Booking -> BookDB : commit status + outbox
Booking -> Redis : DEL booking:status:{id}
Booking -> Kafka : booking event (outbox publisher)

== Hold TTL: Redis is only a hint ==
Sweeper -> InvDB : SELECT holds WHERE status=ACTIVE AND expires_at <= now()
InvDB --> Sweeper : expired holds
Sweeper -> InvDB : transaction: RELEASE hold + outbox
Sweeper -> Kafka : inventory.released
note right of InvDB
  PostgreSQL — источник истины.
  Redis EXPIRE/уведомления не должны быть единственным механизмом освобождения просроченного hold.
end note

@enduml